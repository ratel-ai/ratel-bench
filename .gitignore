# Rust
target/
**/*.rs.bk

# Environment
.env
.env.local
.env.*.local

# Terraform — this repo has no infra; guard against a stray `terraform init`
# leaving a provider cache/state behind (real infra lives in ratel-bench-aws).
.terraform/
*.tfstate
*.tfstate.*

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Node
node_modules/

# TypeScript
*.tsbuildinfo
agent/dist/

# Logs
*.log

# Local scratch
plan.md
progress.md
CLAUDE.local.md

# version-set baseline snapshot (Cargo.toml/lock backup during a git-tag experiment)
.version-set-baseline/

# Claude Code — personal/runtime; commit .claude/skills and .claude/settings.json
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Benchmark outputs (per ADR-0007: corpus and results are not snapshotted)
# — except the published BFCL + SR-Agents reports, which the website repo consumes.
/results/*
!/results/reports/
/results/reports/*
!/results/reports/retrieval-comparison.md
!/results/reports/bfcl/
/results/reports/bfcl/*
!/results/reports/bfcl/report.json
!/results/reports/sragents/
/results/reports/sragents/*
!/results/reports/sragents/report.json
!/results/reports/mcpatlas/
/results/reports/mcpatlas/*
!/results/reports/mcpatlas/report.json
fixtures/*
# The mcpatlas experiment DEFINITION is version-controlled: the pinned task list
# and the catalog manifests are what make a run reproducible. The raw dataset
# rows they are derived from are not (56MB, and re-downloadable).
!fixtures/mcpatlas/
fixtures/mcpatlas/*
!fixtures/mcpatlas/tasks-coding-v1.json
!fixtures/mcpatlas/catalog-coding.json
!fixtures/mcpatlas/catalog-full.json
test-data/
agent/results/
.ratel
